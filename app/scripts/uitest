#!/bin/bash
# Runs on the Mac. Types through the real keyboard extension with XCUITest.
set -euo pipefail
cd "$(dirname "$0")/.."
NAME=${1:-iPhone 17}
TYPE=${2:-iPhone-17}
ID=$(scripts/sim ensure "$NAME" "$TYPE")
scripts/sim boot "$ID"
scripts/sim use "$ID" hex
xcodegen generate -q
rm -rf build/uitest/result.xcresult
xcodebuild test -project HexKeyboard.xcodeproj -scheme Hex -destination "id=$ID" -derivedDataPath build/uitest \
  -resultBundlePath build/uitest/result.xcresult "${@:3}" 2>&1 \
  | grep -E "error:|Test Case .*(passed|failed)|XCTAssert|Executed" || true
