#!/bin/sh
# Rebuilds Packages/HexKeyboard/Sources/KeyboardUI/Resources/nl.lexicon (see scripts/lexicon-nl.py for the sources).
# Runs on the Mac (gloob), unlike scripts/lexicon.
set -e
cd "$(dirname "$0")/.."
python3 scripts/lexicon-nl.py build/lexicon-nl > build/lexicon-nl/words.tsv.part
mv build/lexicon-nl/words.tsv.part build/lexicon-nl/words.tsv
cd Packages/HexKeyboard
swift run -c release LexiconBuilder ../../build/lexicon-nl/words.tsv Sources/KeyboardUI/Resources/nl.lexicon
