#!/bin/bash
# Runs on the Mac. Holds keys through XCUITest while grabbing frames, to see pop-ups and the accent panel.
set -euo pipefail
cd "$(dirname "$0")/.."
NAME=${1:-iPhone 17}
TYPE=${2:-iPhone-17}
KEYBOARD=${3:-hex}
ID=$(scripts/sim ensure "$NAME" "$TYPE")
scripts/sim boot "$ID"
scripts/sim use "$ID" "$KEYBOARD"
slug=$(echo "$NAME" | tr 'A-Z ' 'a-z-')
mkdir -p shots/raw
xcodegen generate -q
rm -f shots/raw/$slug-capture-$KEYBOARD-*.png
xcodebuild build-for-testing -project HexKeyboard.xcodeproj -scheme Hex -destination "id=$ID" \
  -derivedDataPath build/uitest >/dev/null 2>&1
TEST_RUNNER_HEX_CAPTURE=${CAPTURE:-1} xcodebuild test-without-building -project HexKeyboard.xcodeproj -scheme Hex -destination "id=$ID" \
  -derivedDataPath build/uitest -only-testing:HexUITests/CaptureTests >/dev/null 2>&1 &
test_pid=$!
until xcrun simctl spawn "$ID" launchctl list | grep -q "UIKitApplication:com.shahidy.hexkeyboard\["; do sleep 0.5; done
for i in $(seq -w 1 ${FRAMES:-30}); do
  sleep 0.7
  xcrun simctl io "$ID" screenshot "shots/raw/$slug-capture-$KEYBOARD-$i.png" >/dev/null 2>&1 || true
done
wait $test_pid || true
