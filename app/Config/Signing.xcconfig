// espanso-keyboard: signing and identifiers come from the repository's untracked
// Config/Local.xcconfig (see Config/Local.xcconfig.example there). The defaults below
// keep Simulator builds working without it.
APP_BUNDLE_ID = com.example.espansokeyboard
APP_GROUP_ID = group.$(APP_BUNDLE_ID)
#include? "../../Config/Local.xcconfig"
