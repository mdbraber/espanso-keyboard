#!/bin/sh
# Builds the web demo into web/dist: KeyboardCore compiled to WebAssembly plus the static page.
# Needs the swift.org Swift 6.4.0 toolchain (not Xcode's), its Wasm SDK, and binaryen's wasm-opt.
set -e
cd "$(dirname "$0")/../web"
export TOOLCHAINS="${TOOLCHAINS:-swift}"
rm -rf dist
swift package --swift-sdk swift-6.4.0-RELEASE_wasm js -c release --use-cdn
mkdir dist
cp -R .build/plugins/PackageToJS/outputs/Package dist/engine
cp site/* dist/
cp ../Packages/HexKeyboard/Sources/KeyboardUI/Resources/en.lexicon ../Packages/HexKeyboard/Sources/KeyboardUI/Resources/LEXICON-LICENSE dist/
